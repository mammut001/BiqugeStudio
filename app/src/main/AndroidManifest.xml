<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.BiqugeStudio">
        <!-- Android 12+: every activity declares android:exported explicitly. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BiqugeStudio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reader activities stay on application Theme.BiqugeStudio (no splash theme). -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.BiqugeStudio"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LegacyReaderActivity"
            android:exported="false" />
        <!--
          TXT/EPUB open-with + share target.
          Temporary URI grants from the sender (FLAG_GRANT_READ_URI_PERMISSION) are
          honored for content://; see ImportIntentUris.takeReadPermissionIfPossible.
          singleTop delivers repeat shares via onNewIntent.
        -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BiqugeStudio"
            android:windowSoftInputMode="adjustResize">
            <!-- ACTION_VIEW content:// (SAF / DocumentsUI / other apps) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- ACTION_VIEW content:// by extension when MIME is generic (host required by lint) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.txt" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.epub" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.TXT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.EPUB" />
            </intent-filter>
            <!-- ACTION_VIEW file:// (legacy paths; minSdk 23 still sees some providers) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.TXT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.EPUB" />
            </intent-filter>
            <!-- ACTION_SEND share sheet: EXTRA_STREAM content URI (+ MIME) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- ACTION_SEND_MULTIPLE: EXTRA_STREAM ArrayList&lt;Uri&gt; (capped at 20 in code) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".RemoteImportActivity"
            android:exported="false" />
        <activity
            android:name=".WebImportActivity"
            android:exported="false" />
    </application>
</manifest>
