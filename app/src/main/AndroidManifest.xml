<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.BiqugeStudio">
        <!-- Android 12+: every activity declares android:exported explicitly. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BiqugeStudio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reader activities stay on application Theme.BiqugeStudio (no splash theme). -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.BiqugeStudio"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LegacyReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.BiqugeStudio" />
        <activity
            android:name=".SearchActivity"
            android:exported="false" />
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".RemoteImportActivity"
            android:exported="false" />
        <activity
            android:name=".WebImportActivity"
            android:exported="false" />
    </application>
</manifest>
