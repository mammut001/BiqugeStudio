<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- TTS playback may request transient audio focus on media stream. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      Android 11+ package visibility: without this, queryIntentServices(TTS_SERVICE)
      returns empty and the in-app engine picker cannot show Google / 讯飞 / etc.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.google.android.tts" />
        <package android:name="com.iflytek.speechsuite" />
        <package android:name="com.iflytek.inputmethod.tts" />
        <package android:name="com.iflytek.vflynote" />
        <package android:name="com.samsung.SMT" />
        <package android:name="com.huawei.voiceservice" />
        <package android:name="com.huawei.voiceengine" />
        <package android:name="com.xiaomi.mibrain.speech" />
        <package android:name="com.coloros.tts" />
        <package android:name="com.heytap.speechassist" />
        <package android:name="com.oplus.tts" />
        <package android:name="com.oppo.tts" />
        <package android:name="com.oneplus.speech" />
        <package android:name="com.baidu.duersdk.opensdk" />
    </queries>
    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.BiqugeStudio">
        <!-- Android 12+: every activity declares android:exported explicitly. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BiqugeStudio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reader activities stay on application Theme.BiqugeStudio (no splash theme). -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.BiqugeStudio"
            android:windowSoftInputMode="adjustResize" />
        <!--
          TXT/EPUB open-with + share target.
          Temporary URI grants from the sender (FLAG_GRANT_READ_URI_PERMISSION) are
          honored for content://; see ImportIntentUris.takeReadPermissionIfPossible.
          singleTop delivers repeat shares via onNewIntent.
        -->
        <!--
          Share / Open-with target for browser downloads:
          Downloads notification → Share / Open with → 「导入到阅笺」.
          Labels on SEND filters appear in the system share sheet.
        -->
        <activity
            android:name=".SearchActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.BiqugeStudio"
            android:windowSoftInputMode="adjustResize">
            <!-- ACTION_VIEW content:// (SAF / Downloads / DocumentsUI) -->
            <intent-filter android:label="@string/import_share_target_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- ACTION_VIEW content:// by extension when MIME is generic (host required by lint) -->
            <intent-filter android:label="@string/import_share_target_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.txt" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.epub" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.TXT" />
                <data android:scheme="content" android:host="*" android:mimeType="*/*" android:pathPattern=".*\\.EPUB" />
            </intent-filter>
            <!-- ACTION_VIEW file:// (legacy paths; minSdk 23 still sees some providers) -->
            <intent-filter android:label="@string/import_share_target_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/import_share_target_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.txt" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.epub" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.TXT" />
                <data android:scheme="file" android:host="*" android:pathPattern=".*\\.EPUB" />
            </intent-filter>
            <!-- ACTION_SEND share sheet: EXTRA_STREAM content URI (+ MIME) -->
            <intent-filter android:label="@string/import_share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- ACTION_SEND_MULTIPLE: EXTRA_STREAM ArrayList&lt;Uri&gt; (capped at 20 in code) -->
            <intent-filter android:label="@string/import_share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name=".BookDetailActivity"
            android:exported="false" />
        <activity
            android:name=".RemoteImportActivity"
            android:exported="false" />
        <activity
            android:name=".WebImportActivity"
            android:exported="false" />
    </application>
</manifest>
